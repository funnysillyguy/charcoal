# Copy to .env.local and fill in. Never commit the real key.

# Your DeepSeek API key. A key saved in the in-app Settings takes priority over this.
VITE_DEEPSEEK_API_KEY=

# Model ID on api.deepseek.com. V4.1-Flash (vision) is served as "deepseek-flash".
VITE_DEEPSEEK_MODEL=deepseek-flash

# Where the browser sends requests. Default: https://api.deepseek.com/v1
# Use /deepseek/v1 to go through the Vite dev/preview proxy instead.
VITE_DEEPSEEK_BASE_URL=

# Dev-server only: where the /deepseek proxy forwards to (handy for a local mock server).
# DEEPSEEK_PROXY_TARGET=http://localhost:8787

# Optional: point accounts/sync at a different Supabase project (defaults to Charcoal's)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_KEY=sb_publishable_...
